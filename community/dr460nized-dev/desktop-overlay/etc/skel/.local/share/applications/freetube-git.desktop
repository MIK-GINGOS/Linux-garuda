[Desktop Entry]
Categories=Network;
Comment=An open source desktop YouTube player built with privacy in mind.
Exec=firejail --noprofile --blacklist='${RUNUSER}/gvfs' --noexec='${RUNUSER}' freetube
GenericName=YouTube Player
Icon=eu.tiliado.NuvolaAppYoutube
Name=FreeTube
NoDisplay=false
Path[$e]=
StartupNotify=true
Terminal=0
TerminalOptions=
Type=Application
X-KDE-SubstituteUID=false
X-KDE-Username=
